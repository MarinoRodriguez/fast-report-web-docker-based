# ==============================================================================
# FastReport Web Editor - Production Server Environment Variables
# ==============================================================================
# Copy this file to .env on your remote server and adjust the values:
#   cp .env.example .env

# Your Docker Hub username or organization
DOCKER_USER=tu-usuario-dockerhub

# Image tag for ephemeral stream container (default: box64 for native ARM64, or latest for AMD64)
STREAM_TAG=box64

# Optional: Target platform for ephemeral stream containers (leave blank for native auto-detect, or linux/amd64 if forcing QEMU)
STREAM_PLATFORM=

# Public HTTP port for Nginx Gateway (default: 80)
HTTP_PORT=80

# JWT Secret Key for token generation and validation (must be >= 32 characters)
JWT_SECRET=SuperSecretKeyForFastReportWebEditorStreamPoc2026!MustBeAtLeast32BytesLong

# ==============================================================================
# Git Ignore - FastReport WebEditor Docker-Based Project
# ==============================================================================

# --- Backups & Large Archives ---
*.zip
*.tar
*.tar.gz
*.tar.xz
*.7z
*.rar
fastreport-docker-stream-poc-V*.zip

# --- .NET & Visual Studio ---
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
.vs/
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates
_ReSharper*/
*.DotSettings.user
*.patch
*.diff

# --- Node.js / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
env/
venv/
ENV/

# --- Databases & Local Storage ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
**/storage/*.sqlite
**/storage/*.db
**/storage/database.sqlite

# --- Ephemeral Runtime Reports & History ---
**/reports/*
!**/reports/.gitkeep
**/history/*
!**/history/.gitkeep
**/recovery/*
!**/recovery/.gitkeep
**/saved_reports/*
!**/saved_reports/.gitkeep

# --- Environment & Sensitive Files ---
.env
.env.*
!.env.example
*.key
*.pem
*.pfx

# --- Logs & Runtime Output ---
*.log
/tmp/
/workspace/

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# JetBrains / VS Code
.idea/
*.iws
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

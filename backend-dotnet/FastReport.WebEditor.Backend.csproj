<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FastReport.WebEditor.Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base de datos SQLite y Dapper -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.2" />
    <PackageReference Include="Dapper" Version="2.1.66" />

    <!-- Autenticación JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.0" />

    <!-- Motor FastReport para exportación a PDF en Backend -->
    <PackageReference Include="FastReport.OpenSource" Version="2026.2.8" />
    <PackageReference Include="FastReport.OpenSource.Export.PdfSimple" Version="2026.2.8" />

    <!-- Generación de datos Mock -->
    <PackageReference Include="Bogus" Version="35.6.2" />
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=storage/database.sqlite"
  },
  "Jwt": {
    "SecretKey": "SuperSecretKeyForFastReportWebEditorStreamPoc2026!MustBeAtLeast32BytesLong",
    "Issuer": "FastReport.WebEditor.Backend",
    "Audience": "FastReport.WebEditor.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AdminUser": {
    "Username": "admin",
    "Email": "admin@fastreport.local",
    "Password": "AdminPassword123!"
  },
  "Orchestrator": {
    "DockerImage": "fastreport-stream:latest",
    "DockerNetwork": "stream-net",
    "RamTmpfsMb": 2,
    "VncStartPort": 6081,
    "VncEndPort": 6300,
    "StandbyHeartbeatTimeoutSeconds": 40,
    "StandbyGracePeriodMinutes": 5,
    "RecoveryRetentionDays": 7
  }
}
